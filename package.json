{
  "name": "race2feed",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p packages/engine --noEmit && tsc -p packages/server --noEmit && tsc -p packages/web --noEmit",
    "dev": "wrangler dev -c packages/server/wrangler.jsonc --local-upstream localhost:8787",
    "deploy": "wrangler deploy -c packages/server/wrangler.jsonc",
    "build": "npm run build -w @race2feed/web",
    "pretest": "npm run build",
    "e2e": "playwright test -c e2e/playwright.config.ts --trace off",
    "guide:shots": "playwright test -c e2e/guide.config.ts --trace off",
    "guide:pdf": "node scripts/build-guide.mjs",
    "guide": "npm run guide:shots && npm run guide:pdf"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "marked": "18.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
