{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "race2feed",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  "routes": [{ "pattern": "r2f.weiss-audio.com", "custom_domain": true }],
  // Cloudflare Access in front of /control* and /api/control/* (not secrets). See README "Console sign-in".
  "vars": {
    "ACCESS_TEAM_DOMAIN": "silent-butterfly-7498.cloudflareaccess.com",
    "ACCESS_AUD": "00d2d484090bf7ba4b3a038668fea3c5daaa94a1b3861f3178d13bf83486d879"
  }
}
